<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- libwartlog.so: built by `cargo build -p wartlog-ffi`; set WartLogLibDir to use another build -->
    <WartLogLibDir Condition="'$(WartLogLibDir)' == ''">$(MSBuildThisFileDirectory)../../../../target/debug</WartLogLibDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/WartLog/WartLog.csproj" />
    <None Include="$(WartLogLibDir)/libwartlog.so" CopyToOutputDirectory="PreserveNewest" Link="libwartlog.so" />
  </ItemGroup>

</Project>
